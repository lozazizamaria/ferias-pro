# Configuração do Servidor Férias Pro (Template seguro — copie para .env)
PORT=3080
HOST=127.0.0.1
DATA_DIR=./server/data

# Chave mestra AES-256-GCM para criptografar chaves e senhas no banco (mín. 32 chars).
# Se vazio, o servidor gera automaticamente DATA_DIR/.master.key (modo 0600).
MASTER_KEY=

# Sessão & Segurança
SESSION_TTL_HOURS=720
LOGIN_MAX_ATTEMPTS=8
SIGNUP_MAX_ATTEMPTS=20
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=15

# Super Admins principais (adelphi86@gmail.com é sempre incluído)
SUPER_ADMIN_EMAILS=adelphi86@gmail.com

# Autenticação Google OAuth 2.0
GOOGLE_CLIENT_ID=1075987097030-j9htnv6l02rfdbt4spbjp84btj8bopqq.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_LOGIN_CLIENT_ID=

# Inteligência Artificial (Gemini Multimodal), Google Maps & Carteira do Google
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
GOOGLE_MAPS_API_KEY=
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_JSON=
GOOGLE_WALLET_SA_FILE=

# Envio de E-mail (Redefinição de senha) — SMTP nativo ou Resend API
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=My Plan <no-reply@myplan.app>
RESEND_API_KEY=
APP_BASE_URL=https://myplan.digitalinpulse.com.br
